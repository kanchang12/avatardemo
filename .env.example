SECRET_KEY=change-this-to-a-random-string
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Gemini (the brain) ──
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.0-flash

# ── ElevenLabs (voice ID only) ──
# Both are REQUIRED for the cloned voice. If either is missing/placeholder,
# the app still talks using the browser's built-in voice as a fallback.
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Get this from ElevenLabs dashboard -> Voices -> (clone or pick a voice) -> ... -> Copy Voice ID
# It looks like: 21m00Tcm4TlvDq8ikWAM  (NOT the word "petar_cloned_voice_id")
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── Admin (seeds the first admin login) ──
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me

RECORDINGS_DIR=/app/recordings
PORT=8080
