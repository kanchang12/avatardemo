SECRET_KEY=change-this-to-a-random-string
DATABASE_URL=postgresql://user:pass@host:5432/dbname

# ── Gemini via the google-genai SDK (the brain) ──
GEMINI_API_KEY=your_gemini_api_key
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBED_MODEL=gemini-embedding-001
EMBED_DIM=768

# ── ElevenLabs (voice ID only). Missing/placeholder -> browser voice fallback. ──
ELEVENLABS_API_KEY=sk_xxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Real ID from ElevenLabs -> Voices -> ... -> Copy Voice ID (looks like 21m00Tcm4TlvDq8ikWAM)
ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM
ELEVENLABS_MODEL=eleven_multilingual_v2

# ── identity gate / retrieval tuning ──
FACE_TOLERANCE=0.42
TOPK_SEMANTIC=6
TOPK_EPISODIC=4

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=change-me
RECORDINGS_DIR=/app/recordings
PORT=8080
